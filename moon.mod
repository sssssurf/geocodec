// geocodec: location codes and coordinate notation for MoonBit.
//
// The module has no runtime dependencies beyond the MoonBit core library and
// compiles to wasm, wasm-gc and js. See README.md for the supported standards.

name = "sssssurf/geocodec"

version = "0.3.0"

readme = "README.mbt.md"

repository = "https://github.com/sssssurf/geocodec"

license = "Apache-2.0"

keywords = [
  "geohash",
  "plus-code",
  "open-location-code",
  "maidenhead",
  "geo-uri",
  "dms",
  "coordinate",
  "geospatial",
  "text-scanning",
]

description = "Location codes for MoonBit: Geohash, Open Location Code (Plus Codes), Maidenhead locators, RFC 5870 geo URIs and degrees/minutes/seconds, with a unified cell/point model carrying region, resolution and uncertainty, plus bounds, neighbourhoods, geohash covering, free-text scanning and bounded cell-to-geo-URI conversion; no runtime dependencies"
